# Production storage. Required on Vercel or any persistent deployment.
DATABASE_URL=

# Optional. Set to false only for local Postgres without SSL.
POSTGRES_SSL=true

# Optional. Defaults to "postgres" when DATABASE_URL is set, otherwise "file" in development.
# File storage is development-only and will throw in production.
WAITLIST_STORAGE=postgres

# Optional bearer token for GET /api/export.
EXPORT_TOKEN=

