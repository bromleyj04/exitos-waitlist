# Advanced production storage. Required when WAITLIST_STORAGE=postgres.
DATABASE_URL=

# Optional. Set to false only for local Postgres without SSL.
POSTGRES_SSL=true

# Storage adapter: file, postgres, or notion.
# Defaults to "postgres" when DATABASE_URL is set, otherwise "file" in development.
# File storage is development-only and will throw in production.
WAITLIST_STORAGE=postgres

# Manual/self-hosted Notion fallback. Required when WAITLIST_STORAGE=notion.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_WORKSPACE_ID=

# Optional waitli.st Notify-compatible event endpoint.
WAITLIST_NOTIFY_ENDPOINT=
WAITLIST_NOTIFY_SECRET=
NOTIFY_REPLAY_TOKEN=

# Optional bearer token for GET /api/export.
EXPORT_TOKEN=
